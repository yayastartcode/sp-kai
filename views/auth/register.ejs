<section class="py-12">
    <div class="max-w-2xl mx-auto px-4">
        <div class="bg-white rounded-lg shadow-md p-8">
            <h1 class="text-2xl font-bold text-center text-gray-800 mb-2">Formulir Pendaftaran Keanggotaan SP-KAI</h1>
            <p class="text-center text-gray-600 mb-8">Silakan lengkapi data diri Anda</p>

            <form action="/register" method="POST" enctype="multipart/form-data" id="registerForm">
                <!-- Data Diri -->
                <div class="mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b">Data Diri</h2>

                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Nama Lengkap *</label>
                            <input type="text" name="name" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                placeholder="Nama lengkap sesuai KTP">
                        </div>

                        <div>
                            <label class="block text-gray-700 font-medium mb-2">NIPP *</label>
                            <input type="text" name="nipp" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                placeholder="Nomor Induk Pegawai">
                            <p class="text-sm text-gray-500 mt-1">Digunakan untuk login</p>
                        </div>

                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Tempat Lahir *</label>
                            <input type="text" name="tempat_lahir" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                placeholder="Kota kelahiran">
                        </div>

                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Tanggal Lahir *</label>
                            <input type="date" name="tanggal_lahir" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500">
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-gray-700 font-medium mb-2">Unit Kerja *</label>
                            <input type="text" name="asal" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                placeholder="Nama unit kerja / kantor">
                        </div>

                        <!-- Alamat dengan API Wilayah Indonesia -->
                        <div class="md:col-span-2">
                            <label class="block text-gray-700 font-medium mb-2">Alamat Rumah *</label>
                            <div class="grid md:grid-cols-2 gap-3 mb-3">
                                <div>
                                    <select name="province_id" id="province" required
                                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500">
                                        <option value="">-- Pilih Provinsi --</option>
                                    </select>
                                    <input type="hidden" name="province_name" id="province_name">
                                </div>
                                <div>
                                    <select name="regency_id" id="regency" required disabled
                                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 disabled:bg-gray-100">
                                        <option value="">-- Pilih Kab/Kota --</option>
                                    </select>
                                    <input type="hidden" name="regency_name" id="regency_name">
                                </div>
                                <div>
                                    <select name="district_id" id="district" required disabled
                                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 disabled:bg-gray-100">
                                        <option value="">-- Pilih Kecamatan --</option>
                                    </select>
                                    <input type="hidden" name="district_name" id="district_name">
                                </div>
                                <div>
                                    <select name="village_id" id="village" required disabled
                                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 disabled:bg-gray-100">
                                        <option value="">-- Pilih Kelurahan/Desa --</option>
                                    </select>
                                    <input type="hidden" name="village_name" id="village_name">
                                </div>
                            </div>
                            <input type="text" name="address_detail" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                placeholder="RT/RW, Nama Jalan, No. Rumah (detail alamat)">
                        </div>

                        <div>
                            <label class="block text-gray-700 font-medium mb-2">No. Telp/HP *</label>
                            <input type="tel" name="phone" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                placeholder="08xxxxxxxxxx">
                        </div>

                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Foto</label>
                            <input type="file" name="photo" accept="image/*"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500">
                            <p class="text-sm text-gray-500 mt-1">Opsional. Max 5MB</p>
                        </div>
                    </div>
                </div>

                <!-- Password -->
                <div class="mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b">Password</h2>

                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Password *</label>
                            <div class="relative">
                                <input type="password" name="password" id="password" required minlength="6"
                                    class="w-full px-4 py-2 pr-10 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                    placeholder="Minimal 6 karakter">
                                <button type="button" onclick="togglePassword('password')"
                                    class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
                                    <i class="fas fa-eye" id="password-icon"></i>
                                </button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Konfirmasi Password *</label>
                            <div class="relative">
                                <input type="password" name="password_confirm" id="password_confirm" required
                                    minlength="6"
                                    class="w-full px-4 py-2 pr-10 border rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                                    placeholder="Ulangi password">
                                <button type="button" onclick="togglePassword('password_confirm')"
                                    class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
                                    <i class="fas fa-eye" id="password_confirm-icon"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Password Warning -->
                    <div class="mt-4 bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-r-lg">
                        <div class="flex items-start">
                            <i class="fas fa-exclamation-triangle text-yellow-600 mt-0.5 mr-3"></i>
                            <div>
                                <p class="text-sm text-yellow-700 font-medium">Penting!</p>
                                <p class="text-sm text-yellow-600">Pastikan Anda mengingat dan menyimpan password dengan
                                    baik. Password ini akan digunakan untuk login ke akun Anda.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pilihan Kontribusi -->
                <div class="mb-6">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b">Pilihan Kontribusi Iuran</h2>
                    <p class="text-gray-600 mb-4">Pilih metode pembayaran iuran keanggotaan sebesar <strong>0,5% dari
                            upah pokok bulanan</strong>:</p>

                    <div class="space-y-4">
                        <label
                            class="flex items-start p-4 border rounded-lg cursor-pointer hover:bg-orange-50 transition contribution-option">
                            <input type="radio" name="contribution_type" value="transfer" required
                                class="mt-1 mr-3 text-orange-600 focus:ring-orange-500">
                            <div>
                                <span class="font-medium text-gray-800">Transfer Mandiri ke Rekening Serikat</span>
                                <p class="text-sm text-gray-600 mt-1">Saya akan melakukan transfer mandiri setiap bulan
                                    ke rekening DPPP SP-KAI</p>
                            </div>
                        </label>

                        <label
                            class="flex items-start p-4 border rounded-lg cursor-pointer hover:bg-orange-50 transition contribution-option">
                            <input type="radio" name="contribution_type" value="salary_deduction" required
                                class="mt-1 mr-3 text-orange-600 focus:ring-orange-500">
                            <div>
                                <span class="font-medium text-gray-800">Potong Gaji Melalui Payroll oleh
                                    Perusahaan</span>
                                <p class="text-sm text-gray-600 mt-1">Iuran dipotong langsung dari gaji oleh Perusahaan
                                    dan/atau melalui bank</p>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Pernyataan & Janji -->
                <div class="mb-6 p-4 bg-gray-50 rounded-lg">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Pernyataan & Janji</h2>

                    <!-- Placeholder - pilih kontribusi dulu -->
                    <div id="statement-placeholder" class="text-sm text-gray-500 italic mb-4">
                        <i class="fas fa-info-circle mr-2"></i>Silakan pilih metode kontribusi terlebih dahulu untuk
                        melihat pernyataan.
                    </div>

                    <!-- Pernyataan Transfer -->
                    <div id="statement-transfer" class="text-sm text-gray-700 space-y-2 mb-4 hidden">
                        <p>Dengan ini secara sukarela mendaftarkan diri sebagai anggota SP-KAI dan menyatakan dengan
                            sesungguhnya bahwa saya pada saat ini tidak/belum menjadi anggota organisasi serikat pekerja
                            manapun di lingkungan PT Kereta Api Indonesia (Persero).</p>
                        <p><strong>Saya berjanji:</strong></p>
                        <ol class="list-decimal list-inside space-y-1 ml-2">
                            <li>Bahwa Saya bersedia mentaati hak dan kewajiban sebagai anggota SP-KAI sesuai peraturan
                                dan ketentuan di SP-KAI serta menjaga nama baik SP-KAI.</li>
                            <li>Bahwa Saya bersedia membesarkan dan memajukan SP-KAI serta tidak akan melakukan
                                pelanggaran integritas di lingkungan PT KAI.</li>
                            <li>Bahwa Saya bersedia <strong>melakukan pembayaran setiap bulan sebesar 0,5% dari upah
                                    pokok bulanan sebagai iuran keanggotaan yang dilakukan melalui transfer ke Rekening
                                    DPPP SP-KAI</strong>.</li>
                        </ol>
                    </div>

                    <!-- Pernyataan Potong Gaji -->
                    <div id="statement-salary" class="text-sm text-gray-700 space-y-2 mb-4 hidden">
                        <p>Dengan ini secara sukarela mendaftarkan diri sebagai anggota SP-KAI dan menyatakan dengan
                            sesungguhnya bahwa saya pada saat ini tidak/belum menjadi anggota organisasi serikat pekerja
                            apapun di lingkungan PT Kereta Api Indonesia (Persero).</p>
                        <p><strong>Saya berjanji:</strong></p>
                        <ol class="list-decimal list-inside space-y-1 ml-2">
                            <li>Bahwa Saya bersedia mentaati hak dan kewajiban sebagai anggota SP-KAI sesuai peraturan
                                dan ketentuan di SP-KAI serta menjaga nama baik SP-KAI.</li>
                            <li>Bahwa Saya bersedia membesarkan dan memajukan SP-KAI serta tidak akan melakukan
                                pelanggaran integritas di lingkungan PT KAI.</li>
                            <li>Bahwa Saya bersedia <strong>dipotong gaji setiap bulan sebesar 0,5% dari upah pokok
                                    bulanan sebagai iuran keanggotaan yang pemotongannya dilakukan oleh Perusahaan
                                    dan/atau melalui bank</strong>.</li>
                        </ol>
                    </div>

                    <label class="flex items-center cursor-pointer">
                        <input type="checkbox" id="agreement" required
                            class="mr-3 w-5 h-5 text-orange-600 focus:ring-orange-500 rounded">
                        <span class="font-medium text-gray-800">Telah membaca, memahami, menyatakan dan berjanji</span>
                    </label>
                </div>

                <button type="submit" id="submitBtn" disabled
                    class="w-full bg-orange-600 text-white py-3 rounded-lg font-semibold hover:bg-orange-700 transition disabled:bg-gray-400 disabled:cursor-not-allowed">
                    Daftar Keanggotaan
                </button>
            </form>

            <p class="text-center text-gray-600 mt-6">
                Sudah punya akun?
                <a href="/login" class="text-orange-600 font-semibold hover:underline">Login</a>
            </p>
        </div>
    </div>
</section>

<style>
    .contribution-option:has(input:checked) {
        border-color: #ea580c;
        background-color: #fff7ed;
    }
</style>

<script>
    // Enable submit button only when checkbox is checked
    const agreement = document.getElementById('agreement');
    const submitBtn = document.getElementById('submitBtn');

    agreement.addEventListener('change', function () {
        submitBtn.disabled = !this.checked;
    });

    // Toggle password visibility
    function togglePassword(fieldId) {
        const input = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + '-icon');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Toggle statement based on contribution type
    const contributionRadios = document.querySelectorAll('input[name="contribution_type"]');
    const statementPlaceholder = document.getElementById('statement-placeholder');
    const statementTransfer = document.getElementById('statement-transfer');
    const statementSalary = document.getElementById('statement-salary');

    contributionRadios.forEach(radio => {
        radio.addEventListener('change', function () {
            statementPlaceholder.classList.add('hidden');

            if (this.value === 'transfer') {
                statementTransfer.classList.remove('hidden');
                statementSalary.classList.add('hidden');
            } else {
                statementTransfer.classList.add('hidden');
                statementSalary.classList.remove('hidden');
            }
        });
    });

    // API Wilayah Indonesia
    const API_BASE = 'https://yayastartcode.github.io/api-indo/api';

    const provinceSelect = document.getElementById('province');
    const regencySelect = document.getElementById('regency');
    const districtSelect = document.getElementById('district');
    const villageSelect = document.getElementById('village');

    // Load provinces on page load
    async function loadProvinces() {
        try {
            const response = await fetch(`${API_BASE}/provinces.json`);
            const provinces = await response.json();
            provinces.forEach(prov => {
                const option = document.createElement('option');
                option.value = prov.id;
                option.textContent = prov.name;
                option.dataset.name = prov.name;
                provinceSelect.appendChild(option);
            });
        } catch (error) {
            console.error('Error loading provinces:', error);
        }
    }

    // Province change - load regencies
    provinceSelect.addEventListener('change', async function () {
        const provinceId = this.value;
        document.getElementById('province_name').value = this.options[this.selectedIndex].dataset.name || '';

        // Reset dependent selects
        regencySelect.innerHTML = '<option value="">-- Pilih Kab/Kota --</option>';
        districtSelect.innerHTML = '<option value="">-- Pilih Kecamatan --</option>';
        villageSelect.innerHTML = '<option value="">-- Pilih Kelurahan/Desa --</option>';
        regencySelect.disabled = true;
        districtSelect.disabled = true;
        villageSelect.disabled = true;

        if (provinceId) {
            try {
                const response = await fetch(`${API_BASE}/regencies/${provinceId}.json`);
                const regencies = await response.json();
                regencies.forEach(reg => {
                    const option = document.createElement('option');
                    option.value = reg.id;
                    option.textContent = reg.name;
                    option.dataset.name = reg.name;
                    regencySelect.appendChild(option);
                });
                regencySelect.disabled = false;
            } catch (error) {
                console.error('Error loading regencies:', error);
            }
        }
    });

    // Regency change - load districts
    regencySelect.addEventListener('change', async function () {
        const regencyId = this.value;
        document.getElementById('regency_name').value = this.options[this.selectedIndex].dataset.name || '';

        districtSelect.innerHTML = '<option value="">-- Pilih Kecamatan --</option>';
        villageSelect.innerHTML = '<option value="">-- Pilih Kelurahan/Desa --</option>';
        districtSelect.disabled = true;
        villageSelect.disabled = true;

        if (regencyId) {
            try {
                const response = await fetch(`${API_BASE}/districts/${regencyId}.json`);
                const districts = await response.json();
                districts.forEach(dist => {
                    const option = document.createElement('option');
                    option.value = dist.id;
                    option.textContent = dist.name;
                    option.dataset.name = dist.name;
                    districtSelect.appendChild(option);
                });
                districtSelect.disabled = false;
            } catch (error) {
                console.error('Error loading districts:', error);
            }
        }
    });

    // District change - load villages
    districtSelect.addEventListener('change', async function () {
        const districtId = this.value;
        document.getElementById('district_name').value = this.options[this.selectedIndex].dataset.name || '';

        villageSelect.innerHTML = '<option value="">-- Pilih Kelurahan/Desa --</option>';
        villageSelect.disabled = true;

        if (districtId) {
            try {
                const response = await fetch(`${API_BASE}/villages/${districtId}.json`);
                const villages = await response.json();
                villages.forEach(vill => {
                    const option = document.createElement('option');
                    option.value = vill.id;
                    option.textContent = vill.name;
                    option.dataset.name = vill.name;
                    villageSelect.appendChild(option);
                });
                villageSelect.disabled = false;
            } catch (error) {
                console.error('Error loading villages:', error);
            }
        }
    });

    // Village change - save name
    villageSelect.addEventListener('change', function () {
        document.getElementById('village_name').value = this.options[this.selectedIndex].dataset.name || '';
    });

    // Load provinces when page loads
    loadProvinces();
</script>
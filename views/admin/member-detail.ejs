<section class="py-8">
    <div class="max-w-4xl mx-auto px-4">
        <h1 class="text-3xl font-bold text-gray-800 mb-8">Detail Member</h1>

        <div class="grid md:grid-cols-3 gap-6">
            <!-- Profile Card -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <div class="text-center">
                    <div
                        class="w-24 h-24 rounded-full bg-gray-200 mx-auto flex items-center justify-center overflow-hidden">
                        <% if (member.photo) { %>
                            <img src="<%= member.photo %>" alt="" class="w-full h-full object-cover">
                            <% } else { %>
                                <i class="fas fa-user text-3xl text-gray-400"></i>
                                <% } %>
                    </div>
                    <h2 class="text-xl font-semibold mt-4">
                        <%= member.name %>
                    </h2>
                    <p class="text-gray-600">NIPP: <%= member.nipp || '-' %>
                    </p>

                    <% if (member.nias) { %>
                        <div class="mt-2">
                            <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm font-medium">
                                NIAS: <%= member.nias %>
                            </span>
                        </div>
                        <% } %>

                            <% if (member.asal) { %>
                                <p class="text-sm text-gray-500 mt-2">
                                    <i class="fas fa-building mr-1"></i>
                                    <%= member.asal %>
                                </p>
                                <% } %>

                                    <div class="mt-4">
                                        <% if (member.status==='approved' ) { %>
                                            <span
                                                class="bg-green-100 text-green-800 px-4 py-2 rounded-full">Approved</span>
                                            <% } else if (member.status==='pending' ) { %>
                                                <span
                                                    class="bg-yellow-100 text-yellow-800 px-4 py-2 rounded-full">Pending</span>
                                                <% } else { %>
                                                    <span
                                                        class="bg-red-100 text-red-800 px-4 py-2 rounded-full">Rejected</span>
                                                    <% } %>
                                    </div>
                </div>
            </div>

            <!-- Details & Edit Form (col-span-2) -->
            <div class="md:col-span-2 bg-white rounded-lg shadow-md p-6">
                <h3 class="font-semibold text-gray-800 mb-4">Edit Informasi Member</h3>

                <form action="/admin/members/<%= member.id %>/update" method="POST" enctype="multipart/form-data">
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Nama</label>
                            <input type="text" name="name" value="<%= member.name %>" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">NIPP</label>
                            <input type="text" name="nipp" value="<%= member.nipp || '' %>" required
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Tempat Lahir</label>
                            <input type="text" name="tempat_lahir" value="<%= member.tempat_lahir || '' %>"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
                                placeholder="Kota kelahiran">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Tanggal Lahir</label>
                            <input type="date" name="tanggal_lahir"
                                value="<%= member.tanggal_lahir ? new Date(member.tanggal_lahir).toISOString().split('T')[0] : '' %>"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Nomor HP</label>
                            <input type="tel" name="phone" value="<%= member.phone || '' %>"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">NIAS</label>
                            <input type="text" name="nias" value="<%= member.nias || '' %>"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
                                placeholder="Nomor Induk Anggota Serikat">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Unit Kerja / Asal Kantor</label>
                            <input type="text" name="asal" value="<%= member.asal || '' %>"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
                                placeholder="Nama kantor/unit kerja">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Tipe Kontribusi</label>
                            <select name="contribution_type"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                                <option value="salary_deduction" <%=member.contribution_type==='salary_deduction'
                                    ? 'selected' : '' %>>Payroll (Potong Gaji)</option>
                                <option value="transfer" <%=member.contribution_type==='transfer' ? 'selected' : '' %>
                                    >Mandiri (Transfer)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Status</label>
                            <select name="status"
                                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                                <option value="pending" <%=member.status==='pending' ? 'selected' : '' %>>Pending
                                </option>
                                <option value="approved" <%=member.status==='approved' ? 'selected' : '' %>>Approved
                                </option>
                                <option value="rejected" <%=member.status==='rejected' ? 'selected' : '' %>>Rejected
                                </option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">Member ID</label>
                            <input type="text" value="<%= member.member_id || 'Auto-generate' %>" disabled
                                class="w-full px-4 py-2 border rounded-lg bg-gray-100 text-gray-600">
                        </div>
                    </div>

                    <!-- Alamat -->
                    <div class="mb-4">
                        <label class="block text-gray-700 font-medium mb-2">Alamat</label>
                        <div class="grid grid-cols-2 gap-3 mb-3">
                            <div>
                                <select name="province_id" id="province"
                                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                                    <option value="">-- Pilih Provinsi --</option>
                                </select>
                                <input type="hidden" name="province_name" id="province_name"
                                    value="<%= member.province_name || '' %>">
                            </div>
                            <div>
                                <select name="regency_id" id="regency" disabled
                                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 disabled:bg-gray-100">
                                    <option value="">-- Pilih Kab/Kota --</option>
                                </select>
                                <input type="hidden" name="regency_name" id="regency_name"
                                    value="<%= member.regency_name || '' %>">
                            </div>
                            <div>
                                <select name="district_id" id="district" disabled
                                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 disabled:bg-gray-100">
                                    <option value="">-- Pilih Kecamatan --</option>
                                </select>
                                <input type="hidden" name="district_name" id="district_name"
                                    value="<%= member.district_name || '' %>">
                            </div>
                            <div>
                                <select name="village_id" id="village" disabled
                                    class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 disabled:bg-gray-100">
                                    <option value="">-- Pilih Kelurahan/Desa --</option>
                                </select>
                                <input type="hidden" name="village_name" id="village_name"
                                    value="<%= member.village_name || '' %>">
                            </div>
                        </div>
                        <input type="text" name="address_detail" value="<%= member.address_detail || '' %>"
                            class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500"
                            placeholder="RT/RW, Nama Jalan, No. Rumah (detail alamat)">
                        <% if (member.address) { %>
                            <p class="text-xs text-gray-500 mt-1">
                                <i class="fas fa-info-circle mr-1"></i>Alamat saat ini: <%= member.address %>
                            </p>
                            <% } %>
                    </div>

                    <div class="mb-4">
                        <label class="block text-gray-700 font-medium mb-2">Ganti Foto</label>
                        <input type="file" name="photo" accept="image/*"
                            class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500">
                    </div>

                    <div class="flex gap-3">
                        <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700">
                            <i class="fas fa-save mr-2"></i>Simpan Perubahan
                        </button>

                        <% if (member.status==='pending' ) { %>
                            <a href="javascript:void(0)" onclick="document.getElementById('approveForm').submit()"
                                class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600">
                                <i class="fas fa-check mr-2"></i>Approve
                            </a>
                            <% } %>

                                <% if (member.status==='approved' ) { %>
                                    <a href="javascript:void(0)"
                                        onclick="document.getElementById('generateCardForm').submit()"
                                        class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600">
                                        <i class="fas fa-id-card mr-2"></i>
                                        <%= member.card_generated_at ? 'Regenerate' : 'Generate' %> Kartu
                                    </a>
                                    <% } %>
                    </div>
                </form>

                <!-- Hidden Forms -->
                <form id="approveForm" action="/admin/members/<%= member.id %>/approve" method="POST" class="hidden">
                </form>
                <form id="generateCardForm" action="/admin/members/<%= member.id %>/generate-card" method="POST"
                    class="hidden"></form>

                <!-- Admin Reset Password Section -->
                <div class="mt-6 pt-6 border-t">
                    <h4 class="font-semibold text-gray-800 mb-4">
                        <i class="fas fa-key mr-2 text-red-600"></i>Reset Password Member
                    </h4>
                    <form action="/admin/members/<%= member.id %>/reset-password" method="POST"
                        onsubmit="return confirm('Apakah Anda yakin ingin mereset password member ini?')">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">Password Baru *</label>
                                <div class="relative">
                                    <input type="password" name="new_password" id="admin_new_password" required
                                        minlength="6"
                                        class="w-full px-4 py-2 pr-10 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                                        placeholder="Minimal 6 karakter">
                                    <button type="button" onclick="toggleAdminPassword('admin_new_password')"
                                        class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
                                        <i class="fas fa-eye" id="admin_new_password-icon"></i>
                                    </button>
                                </div>
                            </div>
                            <div>
                                <label class="block text-gray-700 text-sm font-medium mb-2">Konfirmasi Password
                                    *</label>
                                <div class="relative">
                                    <input type="password" name="confirm_password" id="admin_confirm_password" required
                                        minlength="6"
                                        class="w-full px-4 py-2 pr-10 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                                        placeholder="Ulangi password">
                                    <button type="button" onclick="toggleAdminPassword('admin_confirm_password')"
                                        class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
                                        <i class="fas fa-eye" id="admin_confirm_password-icon"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="mt-4 bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700">
                            <i class="fas fa-sync-alt mr-2"></i>Reset Password
                        </button>
                    </form>
                </div>

                <!-- Registration Letters Section -->
                <% if (member.contribution_type) { %>
                    <div class="mt-6 pt-6 border-t">
                        <h4 class="font-semibold text-gray-800 mb-4">
                            <i class="fas fa-file-alt mr-2 text-blue-600"></i>Surat Pendaftaran
                        </h4>

                        <!-- Contribution Type -->
                        <div class="bg-gray-50 p-3 rounded-lg mb-4">
                            <p class="text-sm text-gray-600">
                                <strong>Pilihan Kontribusi:</strong>
                                <% if (member.contribution_type==='transfer' ) { %>
                                    <span class="text-blue-600">Transfer Sukarela</span>
                                    <% } else { %>
                                        <span class="text-purple-600">Potong Gaji</span>
                                        <% } %>
                            </p>
                        </div>

                        <!-- Download Buttons -->
                        <div class="flex flex-wrap gap-3 mb-4">
                            <a href="/admin/members/<%= member.id %>/letter/pendaftaran" target="_blank"
                                class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 text-sm">
                                <i class="fas fa-download mr-2"></i>Surat Pendaftaran
                            </a>
                            <% if (member.contribution_type==='salary_deduction' ) { %>
                                <a href="/admin/members/<%= member.id %>/letter/kuasa" target="_blank"
                                    class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 text-sm">
                                    <i class="fas fa-download mr-2"></i>Surat Kuasa
                                </a>
                                <% } %>
                        </div>

                        <!-- Signed Letters Preview -->
                        <div class="mt-4 space-y-3">
                            <p class="font-medium text-gray-700">Surat Tertanda:</p>

                            <!-- Surat Pendaftaran Tertanda -->
                            <div class="flex items-center gap-3">
                                <span class="text-sm text-gray-600 w-32">Surat Pendaftaran:</span>
                                <% if (member.signed_letter) { %>
                                    <a href="<%= member.signed_letter %>" target="_blank"
                                        class="bg-green-100 text-green-700 px-3 py-1 rounded text-sm hover:bg-green-200">
                                        <i class="fas fa-check-circle mr-1"></i>Lihat
                                    </a>
                                    <% } else { %>
                                        <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded text-sm">
                                            <i class="fas fa-clock mr-1"></i>Belum upload
                                        </span>
                                        <% } %>
                            </div>

                            <!-- Surat Kuasa Tertanda (hanya untuk salary_deduction) -->
                            <% if (member.contribution_type==='salary_deduction' ) { %>
                                <div class="flex items-center gap-3">
                                    <span class="text-sm text-gray-600 w-32">Surat Kuasa:</span>
                                    <% if (member.signed_letter_kuasa) { %>
                                        <a href="<%= member.signed_letter_kuasa %>" target="_blank"
                                            class="bg-green-100 text-green-700 px-3 py-1 rounded text-sm hover:bg-green-200">
                                            <i class="fas fa-check-circle mr-1"></i>Lihat
                                        </a>
                                        <% } else { %>
                                            <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded text-sm">
                                                <i class="fas fa-clock mr-1"></i>Belum upload
                                            </span>
                                            <% } %>
                                </div>
                                <% } %>
                        </div>
                    </div>
                    <% } %>

                        <!-- Card Preview -->
                        <% if (card && card.card_image) { %>
                            <div class="mt-6 pt-6 border-t">
                                <h4 class="font-semibold text-gray-800 mb-4">Preview Kartu</h4>

                                <!-- Card Tabs -->
                                <div class="mb-4">
                                    <div class="flex border-b border-gray-200">
                                        <button onclick="showAdminCard('front')" id="admin-tab-front"
                                            class="px-4 py-2 border-b-2 border-orange-500 text-orange-600 font-medium">
                                            <i class="fas fa-id-card mr-1"></i> Depan
                                        </button>
                                        <% if (card.card_image_back) { %>
                                            <button onclick="showAdminCard('back')" id="admin-tab-back"
                                                class="px-4 py-2 border-b-2 border-transparent text-gray-500 hover:text-gray-700">
                                                <i class="fas fa-id-card-alt mr-1"></i> Belakang
                                            </button>
                                            <% } %>
                                    </div>
                                </div>

                                <!-- Card Images -->
                                <div class="bg-gray-100 p-4 rounded-lg flex justify-center">
                                    <img id="admin-card-front" src="<%= card.card_image %>?t=<%= Date.now() %>"
                                        alt="Kartu Depan" class="max-w-full h-auto shadow-lg rounded-lg"
                                        style="max-width: 500px;">
                                    <% if (card.card_image_back) { %>
                                        <img id="admin-card-back" src="<%= card.card_image_back %>?t=<%= Date.now() %>"
                                            alt="Kartu Belakang" class="max-w-full h-auto shadow-lg rounded-lg hidden"
                                            style="max-width: 500px;">
                                        <% } %>
                                </div>

                                <!-- Download Button -->
                                <div class="mt-4 flex gap-3">
                                    <a href="/admin/members/<%= member.id %>/download-card"
                                        class="bg-orange-600 text-white px-4 py-2 rounded-lg hover:bg-orange-700">
                                        <i class="fas fa-download mr-2"></i>Download Kartu
                                    </a>
                                </div>
                            </div>

                            <script>
                                function showAdminCard(side) {
                                    const frontCard = document.getElementById('admin-card-front');
                                    const backCard = document.getElementById('admin-card-back');
                                    const tabFront = document.getElementById('admin-tab-front');
                                    const tabBack = document.getElementById('admin-tab-back');

                                    if (side === 'front') {
                                        frontCard.classList.remove('hidden');
                                        if (backCard) backCard.classList.add('hidden');
                                        tabFront.classList.add('border-orange-500', 'text-orange-600');
                                        tabFront.classList.remove('border-transparent', 'text-gray-500');
                                        if (tabBack) {
                                            tabBack.classList.remove('border-orange-500', 'text-orange-600');
                                            tabBack.classList.add('border-transparent', 'text-gray-500');
                                        }
                                    } else {
                                        frontCard.classList.add('hidden');
                                        if (backCard) backCard.classList.remove('hidden');
                                        tabFront.classList.remove('border-orange-500', 'text-orange-600');
                                        tabFront.classList.add('border-transparent', 'text-gray-500');
                                        if (tabBack) {
                                            tabBack.classList.add('border-orange-500', 'text-orange-600');
                                            tabBack.classList.remove('border-transparent', 'text-gray-500');
                                        }
                                    }
                                }
                            </script>
                            <% } %>

                                <!-- Delete Section -->
                                <div class="mt-6 pt-6 border-t">
                                    <h4 class="font-semibold text-red-600 mb-4">Zona Berbahaya</h4>
                                    <form action="/admin/members/<%= member.id %>/delete" method="POST"
                                        onsubmit="return confirm('Yakin ingin menghapus member ini? Tindakan ini tidak dapat dibatalkan.')">
                                        <button type="submit"
                                            class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">
                                            <i class="fas fa-trash mr-2"></i>Hapus Member
                                        </button>
                                    </form>
                                </div>
            </div>
        </div>

        <div class="mt-6">
            <a href="/admin/members" class="text-purple-600 hover:underline">
                <i class="fas fa-arrow-left mr-2"></i>Kembali ke Daftar Member
            </a>
        </div>
    </div>
</section>

<script>
    // Toggle password visibility for admin reset password
    function toggleAdminPassword(fieldId) {
        const input = document.getElementById(fieldId);
        const icon = document.getElementById(fieldId + '-icon');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // API Wilayah Indonesia
    const API_BASE = 'https://yayastartcode.github.io/api-indo/api';
    const provinceSelect = document.getElementById('province');
    const regencySelect = document.getElementById('regency');
    const districtSelect = document.getElementById('district');
    const villageSelect = document.getElementById('village');

    // Existing member data
    const existingProvinceId = '<%= member.province_id || "" %>';
    const existingRegencyId = '<%= member.regency_id || "" %>';
    const existingDistrictId = '<%= member.district_id || "" %>';
    const existingVillageId = '<%= member.village_id || "" %>';

    async function loadProvinces() {
        try {
            const response = await fetch(`${API_BASE}/provinces.json`);
            const provinces = await response.json();
            provinces.forEach(prov => {
                const option = document.createElement('option');
                option.value = prov.id;
                option.textContent = prov.name;
                option.dataset.name = prov.name;
                if (prov.id === existingProvinceId) option.selected = true;
                provinceSelect.appendChild(option);
            });
            // Auto-load regencies if province exists
            if (existingProvinceId) {
                await loadRegencies(existingProvinceId);
            }
        } catch (error) {
            console.error('Error loading provinces:', error);
        }
    }

    async function loadRegencies(provinceId) {
        try {
            const response = await fetch(`${API_BASE}/regencies/${provinceId}.json`);
            const regencies = await response.json();
            regencySelect.innerHTML = '<option value="">-- Pilih Kab/Kota --</option>';
            regencies.forEach(reg => {
                const option = document.createElement('option');
                option.value = reg.id;
                option.textContent = reg.name;
                option.dataset.name = reg.name;
                if (reg.id === existingRegencyId) option.selected = true;
                regencySelect.appendChild(option);
            });
            regencySelect.disabled = false;
            if (existingRegencyId) await loadDistricts(existingRegencyId);
        } catch (error) {
            console.error('Error loading regencies:', error);
        }
    }

    async function loadDistricts(regencyId) {
        try {
            const response = await fetch(`${API_BASE}/districts/${regencyId}.json`);
            const districts = await response.json();
            districtSelect.innerHTML = '<option value="">-- Pilih Kecamatan --</option>';
            districts.forEach(dist => {
                const option = document.createElement('option');
                option.value = dist.id;
                option.textContent = dist.name;
                option.dataset.name = dist.name;
                if (dist.id === existingDistrictId) option.selected = true;
                districtSelect.appendChild(option);
            });
            districtSelect.disabled = false;
            if (existingDistrictId) await loadVillages(existingDistrictId);
        } catch (error) {
            console.error('Error loading districts:', error);
        }
    }

    async function loadVillages(districtId) {
        try {
            const response = await fetch(`${API_BASE}/villages/${districtId}.json`);
            const villages = await response.json();
            villageSelect.innerHTML = '<option value="">-- Pilih Kelurahan/Desa --</option>';
            villages.forEach(vill => {
                const option = document.createElement('option');
                option.value = vill.id;
                option.textContent = vill.name;
                option.dataset.name = vill.name;
                if (vill.id === existingVillageId) option.selected = true;
                villageSelect.appendChild(option);
            });
            villageSelect.disabled = false;
        } catch (error) {
            console.error('Error loading villages:', error);
        }
    }

    provinceSelect.addEventListener('change', async function () {
        document.getElementById('province_name').value = this.options[this.selectedIndex].dataset.name || '';
        regencySelect.innerHTML = '<option value="">-- Pilih Kab/Kota --</option>';
        districtSelect.innerHTML = '<option value="">-- Pilih Kecamatan --</option>';
        villageSelect.innerHTML = '<option value="">-- Pilih Kelurahan/Desa --</option>';
        regencySelect.disabled = true;
        districtSelect.disabled = true;
        villageSelect.disabled = true;
        if (this.value) await loadRegencies(this.value);
    });

    regencySelect.addEventListener('change', async function () {
        document.getElementById('regency_name').value = this.options[this.selectedIndex].dataset.name || '';
        districtSelect.innerHTML = '<option value="">-- Pilih Kecamatan --</option>';
        villageSelect.innerHTML = '<option value="">-- Pilih Kelurahan/Desa --</option>';
        districtSelect.disabled = true;
        villageSelect.disabled = true;
        if (this.value) await loadDistricts(this.value);
    });

    districtSelect.addEventListener('change', async function () {
        document.getElementById('district_name').value = this.options[this.selectedIndex].dataset.name || '';
        villageSelect.innerHTML = '<option value="">-- Pilih Kelurahan/Desa --</option>';
        villageSelect.disabled = true;
        if (this.value) await loadVillages(this.value);
    });

    villageSelect.addEventListener('change', function () {
        document.getElementById('village_name').value = this.options[this.selectedIndex].dataset.name || '';
    });

    loadProvinces();
</script>